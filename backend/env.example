# Database (Docker: 5454, Local default: 5432)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5454/docassist

# Security
# Generate a new secret key: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Password reset email (required to enable forgot-password delivery)
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Initial administrator (used only when the database has no admin account)
INITIAL_ADMIN_EMAIL=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# OpenAI-compatible LLM API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_QA_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Korean dictionary API
DICTIONARY_API_KEY=
DICTIONARY_API_URL=https://kli.korean.go.kr/term/api/search.do
